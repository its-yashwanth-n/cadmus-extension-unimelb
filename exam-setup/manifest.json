{
  "manifest_version": 3,
  "name": "Cadmus Exam Setup",
  "version": "1.2.0",
  "description": "One-click exam setup on Cadmus: Final exam, auto submission, Turnitin marking, total points, spell check, Schoolyear or Lockdown.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.cadmus.io/*"
  ],
  "action": {
    "default_title": "Cadmus Exam Setup",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "config.js",
      "form.js",
      "runner.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "run-saved": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Apply saved settings to the current Cadmus page"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cadmus-exam-setup@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
